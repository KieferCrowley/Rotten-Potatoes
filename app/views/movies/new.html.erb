<div class="container">
  <% content_for :title, "New movie" %>

  <h1>New movie</h1>

  <div class="form">
    <%= render "form", movie: @movie %>
  </div>

  <br>

  <div class="button">
    <%= link_to "Back to movies", movies_path %>
  </div>
</div>

<style>
  div.container {
    width: 100%;
    justify-self: center;
    justify-items: center;
    text-align: center;
    font-size: 20px;
  }

  h1 {
    width: 99%;
    margin-top: 0;
    padding: 10px;
    background-color: maroon;
    color: white;
  }

  div.form {
    border: 2px solid black;
    padding: 10px;
  }

  div.button {
    border: 2px solid black;
    border-radius: 10px;
    padding: 5px;
  }
</style>